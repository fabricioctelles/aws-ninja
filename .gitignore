# ============================================
# .gitignore - AWS Ninja Skill Repository
# ============================================

# --------------------------------------------
# Credentials & Secrets (CRITICAL)
# --------------------------------------------
.env
.env.*
*.env
.env.local
.env.development
.env.production
.env.*.local

# AWS credentials
.aws/
credentials
*.pem
*.key
*.p12
*.pfx
*.crt
*.cer

# OAuth tokens
token.json
tokens.json
*_token.json
client_secret*.json
oauth*.json
credentials.json

# API keys
*.api_key
*apikey*
*.secret

# SOPS encrypted files that got decrypted
*.decrypted
*.decrypted.*
*.plaintext
*.unencrypted

# --------------------------------------------
# SSH & GPG Keys
# --------------------------------------------
id_rsa
id_rsa.pub
id_ed25519
id_ed25519.pub
id_dsa
id_dsa.pub
*.ppk
known_hosts
authorized_keys
*.gpg
*.asc
secring.*

# --------------------------------------------
# AWS CLI & SDK
# --------------------------------------------
.aws/credentials
.aws/config
aws_access_key*
aws_secret_key*
*.aws

# --------------------------------------------
# Temporary & Cache Files
# --------------------------------------------
*.tmp
*.temp
*.cache
*.bak
*.backup
*.swp
*.swo
*~
.cache/
tmp/
temp/
.tmp/

# --------------------------------------------
# OS Generated Files
# --------------------------------------------
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini
*.lnk

# --------------------------------------------
# IDE & Editor Files
# --------------------------------------------
.idea/
.vscode/
*.sublime-project
*.sublime-workspace
*.code-workspace
.project
.settings/
*.iml
.classpath
*.suo
*.ntvs*
*.njsproj
*.sln.docstates

# --------------------------------------------
# Logs
# --------------------------------------------
*.log
logs/
*.log.*
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# --------------------------------------------
# Package Manager & Dependencies
# --------------------------------------------
node_modules/
__pycache__/
*.py[cod]
*$py.class
.Python
venv/
.venv/
env/
.env/
ENV/
pip-log.txt
pip-delete-this-directory.txt
.tox/
.nox/
.eggs/
*.egg-info/
*.egg

# --------------------------------------------
# Build Outputs
# --------------------------------------------
dist/
build/
out/
target/
*.o
*.so
*.dylib

# --------------------------------------------
# Test & Coverage
# --------------------------------------------
.coverage
htmlcov/
.pytest_cache/
.nyc_output/
coverage/
*.cover

# --------------------------------------------
# Cloned AWS Repositories (large, re-cloneable)
# --------------------------------------------
# Uncomment if you don't want to track cloned repos:
# agent-toolkit-for-aws/
# tools-for-devops-agent/
# sample-apex-skills/
# sample-agent-skills-for-builders/
# sample-well-architected-skills-and-steering/
# sample-corgiro-aws-ops-skills/
# sample-strands-agents-agentskills/
# sample-agentcore-websearch-agent-skill/
# sample-eks-to-agentcore-mcpserver-skills/
# sample-devops-agent-custom-mcp-skills/

# --------------------------------------------
# Miscellaneous
# --------------------------------------------
*.dump
*.sql
*.sqlite
*.db
.history/
.ionide/
